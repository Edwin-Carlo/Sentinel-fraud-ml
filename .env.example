# ============================================
# Sentinel-fraud-ml — Plantilla de variables de entorno
# Copia este archivo como .env y rellena tus valores
# ============================================

# --- DagsHub / MLflow ---
DAGSHUB_USER=<tu-usuario-de-dagshub>
DAGSHUB_REPO=Sentinel-fraud-ml
MLFLOW_TRACKING_URI=https://dagshub.com/<tu-usuario>/Sentinel-fraud-ml.mlflow

# --- DagsHub Token ---
# Genera el tuyo en: https://dagshub.com/user/settings/tokens
DAGSHUB_TOKEN=<tu-token-de-dagshub>

# --- Reproducibilidad ---
RANDOM_SEED=42