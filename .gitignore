# ============================================
# Sentinel-fraud-ml — Archivos ignorados por Git
# ============================================

# --- Entornos virtuales ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- uv ---
# Lockfile: SÍ lo versionamos (uv.lock) para reproducibilidad
# Caché local: no se versiona
.uv/
uv-cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# --- Datos (nunca versionamos datasets crudos ni procesados) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- MLflow local (los runs van a DagsHub, no al repo) ---
mlruns/
mlartifacts/
mlruns.db

# --- Modelos y binarios pesados ---
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth
*.safetensors

# --- Reportes generados (HTML, JSON dinámicos) ---
app_monitoring/reports/*.html
app_monitoring/reports/*.json
reports/*.html
reports/html/
!reports/figures/
!app_monitoring/reports/.gitkeep

# --- Variables de entorno y credenciales (¡NUNCA subir esto!) ---
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# --- Logs ---
*.log
logs/

# --- IDEs y editores ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Testing y coverage ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Ruff y Black ---
.ruff_cache/
.mypy_cache/

# --- Otros ---
*.tmp
*.bak
.cache/